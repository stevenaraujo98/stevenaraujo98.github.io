---
import { t, changeLanguage } from "i18next";
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { certifications } from "../data/certifications";

changeLanguage("en");
---

<BaseLayout title="Resume">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.profile")}</div>
  </div>

  <div class="mb-10 text-justify">
    {t("cv.intro")}
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.education")}</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Master in Artificial Intelligence"
      subtitle="From Mar. 2024 to Feb. 2025 at UNIR-Universidad Internacional de La Rioja, Spain"
      desc="Grade/Verification: https://verifirma.unir.net/CSV/91387afcd6f74233821edf4bc897ee3b-A12A57E0. Artificial Intelligence, Natural Language Processing, and 3 more skills."
    />
    <TimeLineElement
      title="Computer Science Engineering"
      subtitle="From 2016 to Feb. 2022 at Escuela Superior Politécnica del Litoral (ESPOL), Guayaquil, Ecuador"
      desc="Activities and societies: Microsoft Student Cell, Student Representative, Polytechnic Student Federation. 3D Processing and Convolutional Neural Networks (CNN)."
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.experience")}</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="AI Developer"
      subtitle="From May 2025 to Present at ESPOL, Guayaquil, Ecuador"
      desc="Artificial Intelligence, Transformers, and 3 more skills. Improve with AI."
    />
    <TimeLineElement
      title="Freelance Full Stack Developer"
      subtitle="From May 2021 to Present at FullStucks, Remote"
      desc="Project development based on client needs. Tailwind CSS, Bootstrap, and 8 more skills."
    />
    <TimeLineElement
      title="Research Technician"
      subtitle="From Feb. 2024 to Feb. 2025 at Cidis - Espol, Guayaquil, Ecuador"
      desc="AI research applied to person reception and food quality analysis. Convolutional Neural Networks (CNN), Research, and 4 more skills."
    />
    <TimeLineElement
      title="Software Engineer"
      subtitle="From Apr. 2023 to Sept. 2023 at TIA S.A., Guayaquil, Ecuador"
      desc="Tailwind CSS, Celery, and 7 more skills."
    />
    <TimeLineElement
      title="Back-end Developer"
      subtitle="From Feb. 2022 to Jan. 2023 at Nodel, Guayaquil, Ecuador"
      desc="Python, Databricks, and 2 more skills."
    />
    <TimeLineElement
      title="Undergraduate Student Researcher"
      subtitle="From Oct. 2021 to Feb. 2022 at Cidis - Espol, Guayaquil, Ecuador"
      desc="Diameter estimation using 3D images."
    />
    <TimeLineElement
      title="Software Developer"
      subtitle="From Aug. 2020 to Jan. 2021 at Ecuaquimica, Guayaquil, Ecuador"
      desc="Java, Docker, and 3 more skills."
    />
    <TimeLineElement
      title="Board Member"
      subtitle="From Jan. 2019 to Feb. 2020 at Célula Estudiantil Microsoft ESPOL, Guayaquil, Ecuador"
      desc=""
    />
    <TimeLineElement
      title="Undergraduate Student Researcher"
      subtitle="From Nov. 2018 to Sept. 2019 at Cidis - Espol, Guayaquil, Ecuador"
      desc="Participation in the Ibero-American Thematic Network on ICT Applications for Smart Cities project. Vehicle license plate detection and digitization."
    />
    <TimeLineElement
      title="Teaching Assistant Professor"
      subtitle="From Apr. 2018 to Feb. 2019 at ESPOL, Guayaquil, Ecuador"
      desc="Fundamentals of programming. Convolutional Neural Networks (CNN)"
    />
    <TimeLineElement
      title="Career Coordination Assistant"
      subtitle="From Apr. 2018 to Sept. 2018 at Escuela Superior Politécnica del Litoral, Guayaquil, Ecuador"
      desc="Management assistant in the Computer Engineering career coordination. Improve with AI."
    />
    <TimeLineElement
      title="Credit Department"
      subtitle="March 2015 at Grupo DIFARE, Guayaquil, Ecuador"
      desc=""
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("sideBar.publications")}</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Stereo Vision Techniques: A Comparative Study of Traditional and Machine Learning-Based Approaches"
      subtitle="Sharma, H., Bhatt, A., Modi, C., Engelbrecht, A. (eds) Computer Vision and Robotics. CVR 2025/Springer, Cham · Jan 23, 2026"
      desc="Stereo vision, which derives 3D information from pairs of 2D images, remains pivotal for generating precise 3D representations..."
    />
    <TimeLineElement
      title="S-amba: A Multi-View Foul Recognition in Soccer Through a Mamba-Based Approach"
      subtitle="Proceedings of the 13th International Conference on Sport Sciences Research and Technology Support - icSPORTS/SciTePress · Oct 1, 2025"
      desc="In this work, we propose a novel Mamba-based multi-task framework for multi-view foul recognition..."
    />
    <TimeLineElement
      title="SoccerNet 2025 Challenges Results"
      subtitle="Aug 26, 2025"
      desc="The SoccerNet 2025 Challenges mark the fifth annual edition of the SoccerNet open benchmarking effort..."
    />
    <TimeLineElement
      title="Detecting and Characterizing Group Interactions Using 3D Spatial Data to Enhance Human-Robot Engagement"
      subtitle="RCVE · Aug 1, 2025"
      desc="As robotic systems become increasingly integrated into human environments, it is critical to develop advanced methods..."
    />
    <TimeLineElement
      title="Intelligent Virtual Assistants: A Look at Their Privacy Issues"
      subtitle="IEEE · Dec 28, 2022"
      desc="The common adoption of Intelligent Virtual Assistants (IVAs) raises the question about the privacy protection they offer to sensitive data..."
    />
    <TimeLineElement
      title="Off-The-Shelf Based System for Urban Environment Video Analytics"
      subtitle="IEEE · Jul 21, 2020"
      desc="This paper presents the design and implementation details of a system build-up by using off-the-shelf algorithms for urban video analytics..."
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.certifications")}</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    {
      certifications.map((cert) => (
        <li>
          <a href={cert.url || "#"} target="_blank">
            {cert.title} {cert.issuer && `- ${cert.issuer}`}{" "}
            {cert.date && `(${cert.date})`}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t("cv.skills")}</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>Spanish (Native)</li>
    <li>English (B2)</li>
    <li>JavaScript</li>
    <li>C++</li>
    <li>PHP</li>
    <li>Python</li>
    <li>Postgres SQL</li>
    <li>MySQL</li>
    <li>MongoDB</li>
    <li>SnowFlake</li>
    <li>Spark</li>
    <li>CSS</li>
    <li>SASS</li>
    <li>HTML</li>
    <li>Node.js</li>
    <li>React</li>
    <li>NextJs</li>
    <li>VUE</li>
    <li>Astro</li>
    <li>Bootstrap</li>
    <li>Taildwind</li>
    <li>Git</li>
    <li>Jira</li>
    <li>Trello</li>
    <li>BaseCamp</li>
    <li>Scrum</li>
    <li>Shape Up</li>
    <li>LeanStartup</li>
    <li>UI Design</li>
    <li>WEB Design</li>
    <li>Logo Design</li>
    <li>Image Manipulation</li>
    <li>Office Suite</li>
    <li>Adobe Photoshop</li>
    <li>Adobe Lightroom</li>
  </ul>
</BaseLayout>
